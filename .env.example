# free-llm-scout Environment Variables
# Copy to .env and fill in your keys  (PowerShell:  Copy-Item .env.example .env)

# OpenRouter (required for MVP) — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# GitHub Models — free access to GPT-4.1/DeepSeek-R1/Llama-4 with a GitHub PAT
# Create at https://github.com/settings/tokens (classic, no scopes needed)
# NOTE: the env var must NOT start with GITHUB_ — that prefix is reserved
# both for Actions env and for repo secret names.
GH_MODELS_API_KEY=your_github_pat_here

# SiliconFlow (optional) — https://siliconflow.cn
SILICONFLOW_API_KEY=your_siliconflow_key_here

# ModelScope (optional)
MODELSCOPE_API_KEY=your_modelscope_key_here

# Bailian / Alibaba Cloud (optional)
BAILIAN_API_KEY=your_bailian_key_here

# Zhipu AI (optional)
ZHIPU_API_KEY=your_zhipu_key_here

# Moonshot / Kimi (optional)
MOONSHOT_API_KEY=your_moonshot_key_here

# HuggingFace (optional)
HF_API_KEY=your_hf_token_here

# GitHub Actions: set the same names in repo Settings > Secrets > Actions